
#include <stdio.h>

void printMatrix(int a[][3]);

int main(void) {
    int a[2][3] = {
        {1, 2, 3},
        {4, 5, 6}
    };

    printMatrix(a);

    return 0;
}

void printMatrix(int a[][3]) {
    for(int i = 0; i < 2; i++) {
        for(int j = 0; j < 3; j++) {
            printf("%d ", a[i][j]);
        }
        printf("\n");
    }
}
