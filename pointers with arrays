
#include <stdio.h>

void printArray(int *ptr, int size);

int main(void) {
    int numbers[] = {2, 4, 6, 8, 10};
    int *ptr = numbers;

    printArray(ptr, 5);

    printf("Fourth element: %d\n", *(ptr + 3));

    return 0;
}

void printArray(int *ptr, int size) {
    for(int i = 0; i < size; i++) {
        printf("%d ", *(ptr + i));
    }
    printf("\n");
}
