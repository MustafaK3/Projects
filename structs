#include <stdio.h>
typedef struct {
    char lname[20];
    char ssn[15];
}person;

typedef struct {
    person p; // gets a person inside student
    int grade[3];
    char *school; // pointer to school
}student;
void display(student students[]);
int main() {
    student students[2];
    char schoolnames[2][30];
    students[0].school = schoolnames[0]; // points school names to school char for student 1
    students[1].school = schoolnames[1];// points school names to school char for student 2

    printf("enter the details for the first student sarting with last name \n");
    scanf("%19s",students[0].p.lname);
    printf("enter the details for the second student sarting with last name \n");
    scanf("%19s",students[1].p.lname);
    printf("enter the details for the first student's ssn  \n");
    scanf("%14s",students[0].p.ssn);
    printf("enter the details for the second student's ssn  \n");
    scanf("%14s",students[1].p.ssn);
    for(int i=0; i<3; i++) {

    printf("enter the details for the first student's grade  \n");
    scanf("%d",&students[0].grade[i]);
    }
    for(int j=0; j<3; j++) {

    printf("enter the details for the second student's grade  \n");
