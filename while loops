
#include <stdio.h>

void countDown(int number);

int main(void) {
    int number;

    printf("Enter a number between 1 and 10: ");
    scanf("%d", &number);

    while(number < 1 || number > 10) {
        printf("Try again (1-10): ");
        scanf("%d", &number);
    }

    countDown(number);

    return 0;
}

void countDown(int number) {
    while(number >= 1) {
        printf("%d\n", number);
        number--;
    }
}
